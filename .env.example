# .env.example — Template for local development environment variables
# Copy this file to .env and fill in real values (NEVER commit .env to git)
#
# For local development, you can leave DATABASE_URL empty to use SQLite.

# Django secret key — generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True for local development, False for production
DEBUG=True

# Comma-separated list of allowed hosts (leave empty for local dev)
ALLOWED_HOSTS=

# Database URL (leave empty to use SQLite locally)
# Production example: postgresql://user:password@host:5432/dbname
DATABASE_URL=
